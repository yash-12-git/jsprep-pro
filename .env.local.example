# Firebase - Get from Firebase Console > Project Settings > Your Apps
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin - Console > Project Settings > Service Accounts > Generate new key
# Required by /api/verify-payment and the Razorpay webhook. Without these,
# Pro can never be activated server-side.
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Razorpay - Get from Razorpay Dashboard > Settings > API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Razorpay webhook signing secret - Dashboard > Settings > Webhooks.
# This is a DIFFERENT value from RAZORPAY_KEY_SECRET above.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Razorpay subscription Plan IDs - Dashboard > Subscriptions > Plans.
# One plan per currency (a plan is locked to a single currency).
# Only INR is required; other currencies fall back to the INR plan.
RAZORPAY_PLAN_ID_INR=plan_xxxxxxxxxxxx
# RAZORPAY_PLAN_ID_USD=plan_xxxxxxxxxxxx
# RAZORPAY_PLAN_ID_EUR=plan_xxxxxxxxxxxx

# Subscription plan price in paise (₹99 = 9900 paise)
NEXT_PUBLIC_PRO_PRICE_PAISE=9900
NEXT_PUBLIC_PRO_PRICE_DISPLAY=99

GROQ_API_KEY=sk-groq-your-key-here
